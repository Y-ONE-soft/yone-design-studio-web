#!/bin/bash
# 카탈로그(틀 → 디자인) 관리 — 웹 화면(/catalog)과 같은 일을 명령줄에서.
#
#   bin/catalog list                                틀마다 디자인 목록
#   bin/catalog add <계열> <디자인 이름> <책>         책 하나를 디자인으로 등록 (config·css + 페이지 틀·견본 사진)
#   bin/catalog masters <계열> <디자인id> <책>       페이지 틀 5장 다시 뽑기 (원고 자리를 비운 지면)
#   bin/catalog snap <계열> <디자인id> <책>          견본 사진 3장 다시 찍기
#
# <책> 은 bin/viv 와 같다 — 경로, 스튜디오 상대경로, 이름 일부. 여러 권에 걸리면 멈춘다.
set -e
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"
exec python3 -u - "$@" <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.getcwd())
from routes.catalog import snap as _snap, masters as _masters, register_design, _designs
CAT = os.path.join(os.getcwd(), "catalog")

cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
meta = json.load(open(os.path.join(CAT, "catalog.json"), encoding="utf-8"))
if cmd == "list":
    for s, m in meta.items():
        ds = _designs(s)
        print(f"{s:11s} {m['name']:16s} 디자인 {len(ds)}개: "
              + ", ".join(f"{d['id']}={d['name']}{' ✅' if d['masters'] else ' —'}" for d in ds))
elif cmd == "add":
    series, name, book = sys.argv[2], sys.argv[3], sys.argv[4]
    from core.render_vivlio.config import resolve_book
    bdir = os.path.dirname(resolve_book(book))
    did = register_design(series, name, bdir, book)
    print(f"  {series}/{did} '{name}' ← {book}")
elif cmd in ("masters", "snap"):
    series, design, book = sys.argv[2], sys.argv[3], sys.argv[4]
    from core.render_vivlio.config import resolve_book
    bdir = os.path.dirname(resolve_book(book))
    pdf = (_masters if cmd == "masters" else _snap)(series, design, bdir, book)
    print(f"  {series}/{design}: {os.path.basename(pdf) if pdf else '조판된 PDF 없음'}")
else:
    print("사용: bin/catalog list | add <계열> <이름> <책> | masters <계열> <디자인> <책> | snap <계열> <디자인> <책>")
PYEOF
