# Y.ONE DESIGN 통합웹사이트 — 환경변수 예시
#
# 사용법:
#   1) 이 파일을 .env로 복사
#   2) 아래 값을 실제 환경에 맞게 채움
#   3) launchd plist 또는 start_flask.sh에서 export로 등록
#
# 주의: .env 파일 자체는 .gitignore에 포함되어 git에 올라가지 않음.


# ─── 데이터 폴더 위치 ────────────────────────────────────────────────────
# 통합웹이 의존하는 조판/, 디자인/ 폴더가 있는 Y.ONE STUDIO 폴더 절대경로.
# 미지정 시 통합웹사이트 폴더의 상위 폴더를 자동 사용 (config.py fallback).
#
#   아이맥 예: /Users/nhj/Documents/작업/Y.ONE STUDIO
#   맥북 예:   /Users/nhj/Library/Mobile Documents/com~apple~CloudDocs/Documents/작업/Y.ONE STUDIO
#
# ⚠️ 값에 공백/한글이 있으면 반드시 따옴표로 감싸야 합니다.
YONE_STUDIO_ROOT="/Users/nhj/Documents/작업/Y.ONE STUDIO"


# ─── 로그인 비밀번호 ────────────────────────────────────────────────────
# 평문을 코드에 두지 않으려면 여기에 등록.
# 미지정 시 app.py의 fallback 값 사용 (gPwlsldnjs. / assistant2026).
#
YONE_ADMIN_PASSWORD=
YONE_ASSISTANT_PASSWORD=
