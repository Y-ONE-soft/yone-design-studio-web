<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yonestudio.indesign-keepalive</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nhj/dev/yone-design-web/scripts/indesign-keepalive.sh</string>
    </array>

    <!-- 2분마다 InDesign warm 상태 확인. 렌더 중이면 아무것도 안 함. -->
    <key>StartInterval</key>
    <integer>120</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>/Users/nhj/Library/Logs/yonestudio-indesign-keepalive.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nhj/Library/Logs/yonestudio-indesign-keepalive.err.log</string>
</dict>
</plist>
