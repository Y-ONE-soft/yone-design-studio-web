        <!-- ───────── Vercel ───────── -->
        <mxCell id="core" value="&lt;b&gt;yos-core-web&lt;/b&gt;&lt;br&gt;로그인 · 사용자 · 권한 (Auth.js 구글)&lt;br&gt;앱 간 HMAC 링크 토큰 (CHAT_LINK_SECRET 식)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="design" value="&lt;b&gt;yos-design-web&lt;/b&gt; — 지면 디자인 앱&lt;br&gt;&lt;b&gt;/studio&lt;/b&gt; 진입 라우트: 로그인 → 표 발급 → 스튜디오로&lt;br&gt;(STUDIO_URL · STUDIO_LINK_SECRET)&lt;br&gt;디자인 고르기 화면 ← 스튜디오 카탈로그" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="350" width="280" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="contents" value="&lt;b&gt;yos-contents-web&lt;/b&gt;&lt;br&gt;&lt;b&gt;데이터의 주인&lt;/b&gt; — 지문 · 문항 · 단어 · 시험범위&lt;br&gt;화면: 디자인 고르기 → [조판] → 결과 · PDF&lt;br&gt;GET /api/typeset/data — 읽기 API&lt;br&gt;POST /api/hooks/studio — 웹훅 수신&lt;br&gt;STUDIO_SERVICE_URL · STUDIO_SERVICE_TOKEN&lt;br&gt;Blob pathname 저장 → presignUrl 로 PDF 열람" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="250" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="neon" value="&lt;b&gt;Neon Postgres&lt;/b&gt;&lt;br&gt;core · contents · design 스키마&lt;br&gt;(스튜디오는 안 씀)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="480" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="blob" value="&lt;b&gt;Vercel Blob&lt;/b&gt; (contents 와 같은 스토어)&lt;br&gt;studio/renders/… PDF (private)&lt;br&gt;studio/catalog/… 미리보기 (public)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="480" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- ───────── Fly.io ───────── -->
        <mxCell id="studio" value="&lt;b&gt;yos-studio&lt;/b&gt; (이 리포) — 머신 1대 · 2GB · gunicorn 워커 1 + 스레드 · Flask&lt;br&gt;python 3.13 · node 22 · chromium · ghostscript · PyMuPDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;" vertex="1" parent="1">
