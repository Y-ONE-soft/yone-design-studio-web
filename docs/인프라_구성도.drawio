          <mxGeometry x="785" y="300" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;/catalog · /book-studio&lt;/b&gt;&lt;br&gt;디자이너 화면 (Jinja)&lt;br&gt;틀·디자인 등록 · 작업대 · PDF 판정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="300" width="215" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;/api/v1&lt;/b&gt; (routes/api_v1)&lt;br&gt;catalog · renders · embed-token&lt;br&gt;books · health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="785" y="375" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="jobs" value="&lt;b&gt;core/jobs&lt;/b&gt;&lt;br&gt;스레드 잡 + 폴링 (요청 밖에서 조판)&lt;br&gt;_jobs/*.json 기록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="375" width="215" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sources" value="&lt;b&gt;core/sources/yos_contents&lt;/b&gt;&lt;br&gt;contents 데이터 → 틀별 data.json&lt;br&gt;(매핑 코드는 여기 한 곳)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="785" y="450" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="hooks" value="&lt;b&gt;core/yos_hooks · core/blob&lt;/b&gt;&lt;br&gt;웹훅 (x-studio-signature, HMAC hex)&lt;br&gt;Blob 업로드 (SDK 와 같은 REST v12)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="450" width="215" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="pipeline" value="&lt;b&gt;조판 파이프라인&lt;/b&gt; — subprocess: core.render_vivlio.book build · print · verify&lt;br&gt;data.json + 디자인(config · overrides.css) → HTML → &lt;b&gt;Vivliostyle CLI 11 → Chromium&lt;/b&gt; → PDF&lt;br&gt;→ PyMuPDF 마감(간지 · TrimBox) → &lt;b&gt;Ghostscript&lt;/b&gt; CMYK 인쇄본 → verify 검수" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="785" y="530" width="450" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="volume" value="&lt;b&gt;볼륨 studio_data → /data&lt;/b&gt; (10GB)&lt;br&gt;studio/ 책 폴더(조판/교재) · PDF · _jobs&lt;br&gt;catalog/ 틀·디자인 (첫 기동 때 리포 것으로 채움)&lt;br&gt;fonts/ 상용 서체 37개 (sftp 로 올림 · ⚠ 라이선스)&lt;br&gt;icc/ JapanColor2001Coated.icc&lt;br&gt;Fly 자동 스냅샷(매일)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="250" width="240" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="typeset" value="&lt;b&gt;yos-typeset · yos-design-typeset&lt;/b&gt; (기존, contents scripts/typeset)&lt;br&gt;contents·design 이 TYPESET_SERVICE_URL 로 부름&lt;br&gt;Next.js /print 지면 → Vivliostyle 9 → PDF · 무상태 · 자동 확장&lt;br&gt;그대로 둔다 — 계약이 달라 스튜디오와 합치지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1290" y="470" width="240" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="flyops" value="&lt;b&gt;운영&lt;/b&gt;&amp;nbsp; fly deploy · fly logs · fly ssh console&lt;br&gt;fly scale count 1 (볼륨 달린 단일 머신)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1290" y="600" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- ───────── 외부 ───────── -->
        <mxCell id="google" value="&lt;b&gt;Google OAuth&lt;/b&gt;&lt;br&gt;Y.OS 로그인 (Auth.js) — 스튜디오는 직접 안 씀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
