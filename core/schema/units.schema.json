{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "yone/units-v1",
  "title": "디자인 단위 v1 — 원자 → 부품 → 블록 → 지면 → 틀 · 옷 · 세트",
  "description": "치수는 mm(원점 = 부모의 왼쪽 위), 글자 크기·선 굵기는 pt. 색·서체는 값이 아니라 토큰 이름($이름)으로만 적고 값은 옷(skin)이 준다. PDF·이미지·프롬프트 분해기의 출력도 같은 원자(atom) 형식이다. 설명과 보기는 docs/디자인_단위_스키마.md.",
  "definitions": {

    "mm": {"type": "number"},
    "pt": {"type": "number", "minimum": 0},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
    "token": {"type": "string", "pattern": "^\\$[a-z][a-z0-9_]*$", "description": "토큰 참조. 옷의 tokens.color / tokens.font 에서 값을 찾는다"},
    "bind": {"type": "string", "pattern": "^(sys\\.)?[a-z][a-z0-9_]*$", "description": "이 원자에 들어갈 필드 이름. sys.page_no · sys.section · sys.title 은 책이 채운다"},

    "box": {
      "type": "object", "required": ["x", "y", "w", "h"],
      "properties": {"x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm"}}
    },
    "stroke": {
      "description": "획 — 인디자인 획 패널",
      "type": "object",
      "properties": {"w": {"$ref": "#/definitions/pt"}, "color": {"$ref": "#/definitions/token"}, "dash": {"type": "array", "items": {"$ref": "#/definitions/pt"}, "description": "점선 패턴 pt — [선, 빈칸, …] (인디자인 획 유형)"},
                     "tint": {"type": "number", "minimum": 0, "maximum": 100, "description": "획 색조 % (인디자인 Tint). 없으면 100"},
                     "cap": {"enum": ["butt", "round", "square"], "description": "선 끝 모양(인디자인 Cap). 없으면 butt"},
                     "join": {"enum": ["miter", "round", "bevel"], "description": "모서리 연결(인디자인 Join). 없으면 miter"},
                     "miter": {"type": "number", "minimum": 1, "description": "마이터 한계. 없으면 4"},
                     "align": {"enum": ["center", "inside", "outside"], "description": "획 정렬(인디자인 Align Stroke) — 가운데(기본)·안쪽·바깥쪽"},
                     "gap_color": {"$ref": "#/definitions/token", "description": "점선 사이 색(인디자인 간격 색). 없으면 비움"},
                     "start": {"$ref": "#/definitions/arrow", "description": "선 시작 화살촉"},
                     "end": {"$ref": "#/definitions/arrow", "description": "선 끝 화살촉"}}
    },
    "wrap": {
      "description": "텍스트 감싸기 — 이 원자와 겹치는 글상자의 글이 둘레로 흐른다(인디자인 텍스트 감싸기, 사각형)",
      "type": "object",
      "properties": {
        "mode": {"enum": ["none", "bbox"], "description": "none = 안 감쌈 · bbox = 상자 둘레로"},
        "offset": {"$ref": "#/definitions/mm", "description": "글과 띄울 거리 mm"},
        "side": {"enum": ["auto", "left", "right"], "description": "글이 어느 쪽으로 흐를지. auto = 넓은 쪽"}
      }
    },
    "arrow": {"enum": ["none", "arrow", "open", "circle", "square", "bar"], "description": "화살촉 모양(인디자인 시작/끝 모양)"},
    "decor": {
      "description": "밑줄·취소선 꾸밈(인디자인 밑줄 옵션·취소선 옵션)",
      "type": "object",
      "properties": {"w": {"$ref": "#/definitions/pt"}, "color": {"$ref": "#/definitions/token"}, "offset": {"$ref": "#/definitions/pt"}, "style": {"enum": ["solid", "dotted", "dashed", "wavy", "double"]}}
    },
    "rule": {
      "description": "단락 경계선 — 굵기·색·단락에서 떨어진 거리(인디자인 단락 경계선)",
      "type": "object",
      "properties": {"w": {"$ref": "#/definitions/pt"}, "color": {"$ref": "#/definitions/token"}, "offset": {"$ref": "#/definitions/mm"}}
    },
    "fx": {
      "description": "효과 — 인디자인 개체 효과(혼합 모드·그림자·광선·페더). 원자 어디에나 붙는다",
      "type": "object",
      "properties": {
        "blend": {"enum": ["normal", "multiply", "screen", "overlay", "darken", "lighten", "color-dodge", "color-burn", "hard-light", "soft-light", "difference", "exclusion"], "description": "혼합 모드"},
        "shadow": {"type": "object", "description": "그림자 — 거리·번짐은 mm", "properties": {"x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "blur": {"$ref": "#/definitions/mm"}, "color": {"$ref": "#/definitions/token"}, "opacity": {"$ref": "#/definitions/opacity"}, "inner": {"type": "boolean", "description": "내부 그림자"}}},
        "glow": {"type": "object", "description": "광선", "properties": {"blur": {"$ref": "#/definitions/mm"}, "color": {"$ref": "#/definitions/token"}, "opacity": {"$ref": "#/definitions/opacity"}, "inner": {"type": "boolean"}}},
        "feather": {"$ref": "#/definitions/mm", "description": "기본 페더 — 가장자리를 이만큼 흐리게(mm)"},
        "bevel": {"type": "object", "description": "경사와 엠보스 — 빛을 받아 도드라진다",
                  "properties": {"size": {"$ref": "#/definitions/mm"}, "depth": {"type": "number", "minimum": 0, "description": "깊이(1 = 보통)"}, "angle": {"type": "number", "description": "빛 방향 °"}}},
        "satin": {"type": "object", "description": "새틴 — 안쪽에 비단결 같은 그림자",
                  "properties": {"blur": {"$ref": "#/definitions/mm"}, "distance": {"$ref": "#/definitions/mm"}, "color": {"$ref": "#/definitions/token"}, "opacity": {"$ref": "#/definitions/opacity"}}}
      }
    },
    "rotate": {"type": "number", "minimum": -360, "maximum": 360, "description": "회전 각도(°, 시계 방향, 원자의 가운데를 축으로). 없으면 0"},
    "gradient": {
      "description": "그라디언트 채움(인디자인 그라디언트 견본). 있으면 fill 대신 쓴다. 색은 토큰",
      "type": "object", "required": ["stops"],
      "properties": {
        "type": {"enum": ["linear", "radial"], "description": "없으면 linear"},
        "angle": {"type": "number", "description": "linear 의 방향(°). 0 = 왼쪽→오른쪽, 90 = 위→아래"},
        "stops": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["c"], "properties": {"c": {"$ref": "#/definitions/token"}, "at": {"type": "number", "minimum": 0, "maximum": 1, "description": "0~1 위치. 없으면 고르게"}}}}
      }
    },
    "radius": {"oneOf": [{"$ref": "#/definitions/mm"}, {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/definitions/mm"}}],
               "description": "둥근 모서리. 하나 또는 [왼쪽 위, 오른쪽 위, 오른쪽 아래, 왼쪽 아래]"},
    "opacity": {"type": "number", "minimum": 0, "maximum": 1, "description": "불투명도 0~1. 없으면 1"},
    "run": {
      "description": "서식 조각 — 글 안에서 굵게·기울임·밑줄·위첨자·다른 색·서체·크기가 섞인 부분(인디자인 문자 스타일). core/render_vivlio/richtext.py 형식 + color·font·size",
      "type": "object", "required": ["t"],
      "properties": {
        "t": {"type": "string"}, "b": {"type": "boolean"}, "i": {"type": "boolean"}, "u": {"type": "boolean"}, "s": {"type": "boolean", "description": "취소선"},
        "sup": {"type": "boolean"}, "sub": {"type": "boolean"},
        "color": {"$ref": "#/definitions/token"}, "font": {"$ref": "#/definitions/token"}, "size": {"$ref": "#/definitions/pt"},
        "bshift": {"$ref": "#/definitions/pt", "description": "기준선 이동 pt — 양수면 위로"},
        "hscale": {"type": "number", "minimum": 1, "description": "장평 가로 %"},
        "vscale": {"type": "number", "minimum": 1, "description": "장평 세로 %"},
        "tracking": {"type": "number", "description": "자간 1/1000 em"},
        "case": {"enum": ["upper", "lower", "small"], "description": "대문자·소문자·작은대문자"},
        "anc": {"type": "object", "description": "글 안에 고정한 개체(인디자인 앵커드) — 글 흐름 안에 부품을 끼운다",
                "required": ["part"], "properties": {"part": {"$ref": "#/definitions/id"}, "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm"},
                                                     "align": {"enum": ["inline", "left", "right"], "description": "inline = 글줄 안(기본) · left/right = 그 쪽으로 띄워 글이 감싼다"}}}
      }
    },
    "rich": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"$ref": "#/definitions/run"}]}},

    "atom": {
      "description": "원자 — 인디자인 오브젝트 하나: text(글상자) line(선) rect(면) ellipse(원) image(그림) path(도형). 콘텐츠는 bind 로만 들어온다. 모두 rotate·opacity 를 가질 수 있다",
      "oneOf": [
        {"$ref": "#/definitions/atom_text"}, {"$ref": "#/definitions/atom_line"}, {"$ref": "#/definitions/atom_rect"},
        {"$ref": "#/definitions/atom_ellipse"}, {"$ref": "#/definitions/atom_image"}, {"$ref": "#/definitions/atom_path"}
      ]
    },
    "atom_text": {
      "type": "object", "required": ["t", "x", "y", "w", "h", "font", "size"],
      "properties": {
        "t": {"const": "text"},
        "x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "w": {"$ref": "#/definitions/mm"},
        "h": {"$ref": "#/definitions/mm", "description": "최소 높이. 글이 길면 아래로 늘어난다"},
        "font": {"$ref": "#/definitions/token"}, "size": {"$ref": "#/definitions/pt"},
        "style": {"$ref": "#/definitions/id", "description": "단락 스타일 이름 — 옷의 styles 에서 서체·크기·행간·색·정렬·자간·들여쓰기·간격을 가져온다(인디자인 단락 스타일). 스타일에 있는 값이 원자 값보다 우선"},
        "color": {"$ref": "#/definitions/token"}, "leading": {"$ref": "#/definitions/pt"},
        "align": {"enum": ["left", "center", "right", "justify"]},
        "text": {"oneOf": [{"type": "string"}, {"$ref": "#/definitions/rich"}], "description": "고정 글 또는 견본 글(bind 가 있으면 견본). 서식이 섞이면 조각 목록(rich). 줄바꿈(\\n) = 단락"},
        "bind": {"$ref": "#/definitions/bind"},
        "tracking": {"type": "number", "description": "자간 — 인디자인 단위(1/1000 em). 없으면 0"},
        "indent": {"$ref": "#/definitions/mm", "description": "왼쪽 들여쓰기(단락 전체)"},
        "indent_first": {"type": "number", "description": "첫 줄 들여쓰기(mm). 음수 = 내어쓰기(선지 ①~⑤ 둘째 줄이 글머리 뒤에서 시작)"},
        "indent_right": {"$ref": "#/definitions/mm", "description": "오른쪽 들여쓰기"},
        "space_before": {"$ref": "#/definitions/mm", "description": "단락 앞 간격"},
        "space_after": {"$ref": "#/definitions/mm", "description": "단락 뒤 간격"},
        "inset": {"oneOf": [{"$ref": "#/definitions/mm"}, {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/definitions/mm"}}],
                  "description": "글상자 안쪽 여백(인디자인 텍스트 프레임 옵션). 하나 또는 [위, 오른쪽, 아래, 왼쪽]"},
        "valign": {"enum": ["top", "center", "bottom"], "description": "세로 정렬. 없으면 top"},
        "columns": {"type": "integer", "minimum": 1, "maximum": 6, "description": "글상자 안 단 수. 없으면 1"},
        "gutter": {"$ref": "#/definitions/mm", "description": "단 사이 간격"},
        "rule_above": {"$ref": "#/definitions/rule", "description": "단락 위 경계선"},
        "rule_below": {"$ref": "#/definitions/rule", "description": "단락 아래 경계선"},
        "shade": {"$ref": "#/definitions/token", "description": "단락 음영 색(인디자인 단락 음영)"},
        "bullet": {"enum": ["disc", "circle", "square", "decimal", "decimal-paren", "upper-alpha", "lower-alpha"], "description": "글머리 기호·번호 매기기"},
        "tab": {"$ref": "#/definitions/mm", "description": "탭 간격 — 글 안의 탭 문자가 이 간격으로 선다"},
        "tabs": {"type": "array", "description": "탭 자리 — 인디자인 탭 패널(자리·정렬·리더). 있으면 tab 보다 우선",
                 "items": {"type": "object", "required": ["at"], "properties": {
                     "at": {"$ref": "#/definitions/mm", "description": "글상자 왼쪽에서 mm"},
                     "align": {"enum": ["left", "center", "right", "decimal"], "description": "없으면 left"},
                     "leader": {"type": "string", "maxLength": 4, "description": "리더 — 빈 자리를 채울 글자(예: . 또는 ·)"}}}},
        "num": {"enum": ["1", "01", "(1)", "\u2460", "\uac00", "A", "a"], "description": "번호 매기기(인디자인 글머리 기호 및 번호 매기기) — 원고가 번호를 안 줘도 앞 번호 다음으로 저절로 매긴다. 면마다 1부터"},
        "num_start": {"type": "integer", "minimum": 1, "description": "번호 시작 (없으면 1)"},
        "num_list": {"type": "string", "maxLength": 40, "description": "번호 목록 이름 — 같은 이름끼리 이어서 매긴다(없으면 자리 이름으로 나뉜다)"},
        "hyphenate": {"type": "boolean", "description": "하이픈 넣기(인디자인 하이픈). 영어 본문에서 양끝맞춤이 벌어지는 걸 줄인다"},
        "justify_mode": {"enum": ["word", "letter"], "description": "양끝맞춤을 낱말 사이로(기본) 또는 글자 사이까지"},
        "word_spacing": {"type": "number", "description": "낱말 사이 더하기 — em 의 1/1000"},
        "snap_baseline": {"type": "boolean", "description": "기준선 격자에 맞추기 — 지면의 baseline_grid 줄에 글줄을 세운다"},
        "first_baseline": {"$ref": "#/definitions/mm", "description": "첫 줄을 상자 위에서 이만큼 내린다(인디자인 첫 기준선)"},
        "auto_size": {"type": "boolean", "description": "글이 길면 상자가 아래로 늘어난다(기본 true). false 면 넘쳐도 상자 높이를 지킨다"},
        "h_scale": {"type": "number", "minimum": 1, "description": "장평 가로 % (인디자인 수평 비율). 없으면 100"},
        "v_scale": {"type": "number", "minimum": 1, "description": "장평 세로 % (인디자인 수직 비율). 없으면 100"},
        "baseline": {"$ref": "#/definitions/pt", "description": "기준선 이동 pt — 양수면 위로"},
        "kerning": {"enum": ["metrics", "none"], "description": "커닝 — metrics(기본) 또는 끄기"},
        "drop_cap": {"type": "object", "description": "드롭캡 — 첫 글자를 몇 줄 높이로(인디자인 단락의 드롭캡)",
                     "properties": {"lines": {"type": "integer", "minimum": 2, "maximum": 8}, "chars": {"type": "integer", "minimum": 1, "maximum": 4}}},
        "column_rule": {"$ref": "#/definitions/rule", "description": "단 사이 괘선(인디자인 단 사이 괘선)"},
        "case": {"enum": ["upper", "lower", "small"], "description": "대문자·소문자·작은대문자"},
        "underline": {"$ref": "#/definitions/decor", "description": "밑줄 꾸밈 — 굵기·색·아래로 내린 거리"},
        "strike": {"$ref": "#/definitions/decor", "description": "취소선 꾸밈"},
        "rotate": {"$ref": "#/definitions/rotate"}, "opacity": {"$ref": "#/definitions/opacity"},
        "tint": {"type": "number", "minimum": 0, "maximum": 100, "description": "채움 색조 % (인디자인 Tint). 없으면 100"},
        "fx": {"$ref": "#/definitions/fx"},
        "flip": {"enum": ["h", "v", "hv"], "description": "뒤집기 — 좌우(h)·상하(v)·둘 다"},
        "skew": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}, "description": "기울이기 [가로°, 세로°] (인디자인 전단)"},
        "scale": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}, "description": "배율 [가로%, 세로%] — 자리는 그대로 두고 늘린다"},
        "origin": {"enum": ["center", "tl", "tr", "bl", "br"], "description": "변형 기준점(인디자인 기준점) — 없으면 가운데"},
        "ostyle": {"type": "string", "description": "개체 스타일 이름 — 옷의 obj_styles 에서 채움·획·모서리·효과를 가져온다. 원자에 적힌 값이 우선(인디자인 개체 스타일)"},
        "layer": {"$ref": "#/definitions/id", "description": "이 원자가 놓인 레이어 id (지면의 layers). 없으면 맨 아래 레이어"},
        "wrap": {"$ref": "#/definitions/wrap"},
        "nonprint": {"type": "boolean", "description": "비인쇄 — 화면에만 보이고 PDF·인쇄에는 안 나온다(인디자인 비인쇄)"},
        "overprint": {"type": "boolean", "description": "중복인쇄 — 인쇄 분판에서 밑색을 파지 않는다(값만 보관, 화면은 그대로)"}
      }
    },
    "atom_line": {
      "type": "object", "required": ["t", "x1", "y1", "x2", "y2"],
      "properties": {
        "t": {"const": "line"},
        "x1": {"$ref": "#/definitions/mm"}, "y1": {"$ref": "#/definitions/mm"}, "x2": {"$ref": "#/definitions/mm"}, "y2": {"$ref": "#/definitions/mm"},
        "stroke": {"$ref": "#/definitions/stroke"},
        "opacity": {"$ref": "#/definitions/opacity"},
        "tint": {"type": "number", "minimum": 0, "maximum": 100, "description": "채움 색조 % (인디자인 Tint). 없으면 100"},
        "fx": {"$ref": "#/definitions/fx"},
        "flip": {"enum": ["h", "v", "hv"], "description": "뒤집기 — 좌우(h)·상하(v)·둘 다"},
        "skew": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}, "description": "기울이기 [가로°, 세로°] (인디자인 전단)"},
        "scale": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}, "description": "배율 [가로%, 세로%] — 자리는 그대로 두고 늘린다"},
        "origin": {"enum": ["center", "tl", "tr", "bl", "br"], "description": "변형 기준점(인디자인 기준점) — 없으면 가운데"},
