      "properties": {
        "page_start": {"type": "integer", "minimum": 1, "description": "쪽 번호 시작 — 문서 첫 쪽의 쪽 번호(인디자인 페이지 번호 시작). 없으면 1"},
        "id": {"$ref": "#/definitions/id"}, "name": {"type": "string"},
        "content": {"type": "object", "description": "넣어 둔 원고 — {자리 이름: 글 | [글…]}. 틀(자리·임시 글·스타일)에 넣으면 임시 글 대신 나온다 (core/units/content.py). 흐름 자리(「번호+발문+…」)는 [문항…] — 문항 = [[자리, 글 또는 꾸밈 조각 목록], …] (문항 안 차례) 또는 {자리: 글}. 「원고마다」 묶음의 첫 쪽 이름은 [레코드…] — 레코드 = {자리: 글 | [글…] | [문항…]} 하나가 묶음 한 벌 (content.plan_pages)",
                    "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"oneOf": [
                      {"type": "string"},
                      {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": ["string", "array"]}}},
                      {"type": "object", "additionalProperties": {"type": ["string", "array"]}}]}}]}},
        "map": {"type": "object", "additionalProperties": {"$ref": "#/definitions/id"},
                "description": "원고 연결표 — {원고 유형 이름 또는 원고 쪽 블록 id: 이 문서에서 쓸 블록 id}. 코드에 박아 두던 매칭표를 문서에 둔다",
                "propertyNames": {"maxLength": 60}},
        "catalog": {"type": "object", "description": "관리에 등록한 곳 — {series: 틀, design: 디자인 폴더}. 다시 등록하면 같은 카드를 새로 그린다 (routes/units.register_design)",
                    "properties": {"series": {"type": "string"}, "design": {"type": "string"}}},
        "skin": {"$ref": "#/definitions/id", "description": "이 문서의 브랜드(옷) — 열 때 이 옷으로 그린다. 없으면 화면에서 고른 옷"},
        "facing": {"type": "boolean", "description": "페이지 마주보기 — 켜면 2·3쪽이 한 장(펼침면)으로 보이고 1쪽은 오른쪽. 안 적으면 켠 것으로 본다"}, "spec": {"$ref": "#/definitions/id"},
        "order": {"enum": ["by_page", "by_set"], "description": "묶는 순서 — by_page(기본·유형별) = 「지문마다」 면 하나를 원고 수만큼 몰아 찍는다. by_set(지문별) = 잇닿은 「지문마다」 면들을 한 벌로 묶어 원고마다 한 벌씩"},
        "front": {"type": "array", "items": {"$ref": "#/definitions/id"}},
        "sections": {"type": "array", "items": {"$ref": "#/definitions/section"}},
        "back": {"type": "array", "items": {"$ref": "#/definitions/id"}}
      }
    },

    "skin": {
      "description": "옷 — 토큰 값 + 블록별 모양 선택 + 이미지 교체. 브랜드·학교·강사",
      "type": "object", "required": ["id", "name", "tokens"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "name": {"type": "string"},
        "tokens": {"type": "object", "properties": {
          "color": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}},
          "font": {"type": "object", "additionalProperties": {"type": "string", "description": "서체 family 이름"}}
        }},
        "variants": {"type": "object", "additionalProperties": {"$ref": "#/definitions/id"}, "description": "블록 id → 모양 id. 없으면 첫 모양"},
        "images": {"type": "object", "additionalProperties": {"type": "string"}, "description": "image 원자의 src → 파일 경로"},
        "obj_styles": {"type": "object", "description": "개체 스타일 — 이름마다 채움·획·모서리·효과 묶음(인디자인 개체 스타일). 원자의 ostyle 이 가리킨다",
                       "additionalProperties": {"type": "object"}},
        "cstyles": {"type": "object", "description": "문자 스타일 — 이름 → 글자 꾸밈(인디자인 문자 스타일). 글 조각·GREP 규칙·윗주·옆 메모의 cs 가 가리킨다",
          "additionalProperties": {"type": "object", "properties": {
            "font": {"$ref": "#/definitions/token"}, "size": {"$ref": "#/definitions/pt"}, "color": {"$ref": "#/definitions/token"},
            "weight": {"type": "integer", "minimum": 100, "maximum": 900}, "b": {"type": "boolean"}, "i": {"type": "boolean"},
            "track": {"type": "number", "description": "자간 1/1000 em"}, "bshift": {"type": "number", "description": "기준선 이동 pt — 양수면 위로"},
            "u": {"type": "boolean", "description": "밑줄"}, "u_style": {"enum": ["wavy", "dotted", "dashed", "double"], "description": "밑줄 모양 — 없으면 실선"},
            "line": {"type": "number", "description": "밑줄 굵기 mm"}, "line_off": {"type": "number", "description": "기준선 → 밑줄 가운데 mm"}, "line_color": {"$ref": "#/definitions/token"},
            "bg": {"$ref": "#/definitions/token", "description": "바탕색 — 글 뒤 색 면(형광 · 번호 배지)"},
            "bg_pad": {"type": "number", "description": "바탕을 글 밖으로 넓히는 양 mm — 글 자리는 그대로"}, "bg_r": {"type": "number", "description": "바탕 모서리 mm"},
            "bg_band": {"type": "number", "description": "띠 두께 mm — 바탕을 가로 띠로(형광펜). 없으면 글 높이 전체"},
            "bg_off": {"type": "number", "description": "띠 높이 — 기준선에서 띠 가운데까지 위로 mm"}}}},
        "styles": {"type": "object", "description": "단락 스타일 — 이름 → 글 속성. 글 원자의 style 이 가리킨다. 원고 docx 의 단락 스타일 이름과 같으면 파서가 자리를 맞춘다",
          "additionalProperties": {"type": "object", "properties": {
            "font": {"$ref": "#/definitions/token"}, "size": {"$ref": "#/definitions/pt"}, "leading": {"$ref": "#/definitions/pt"},
            "color": {"$ref": "#/definitions/token"}, "align": {"enum": ["left", "center", "right", "justify"]},
            "tracking": {"type": "number"}, "tsume": {"type": "number", "minimum": 0, "maximum": 100}, "indent": {"$ref": "#/definitions/mm"}, "indent_first": {"type": "number"}, "indent_right": {"$ref": "#/definitions/mm"},
            "space_before": {"$ref": "#/definitions/mm"}, "space_after": {"$ref": "#/definitions/mm"},
            "b": {"type": "boolean"}, "i": {"type": "boolean"}
          }}}
      }
    },

    "set": {
      "description": "세트 — 콘텐츠가 오는 단위. 함께 오고 함께 놓인다. contents 는 이것만 보낸다",
      "type": "object", "required": ["kind", "id", "blocks"],
      "properties": {
        "kind": {"type": "string", "description": "passage · exam · day …"}, "id": {"type": "string", "description": "지문 번호·회차"},
        "keep": {"type": "boolean", "description": "면 넘어가며 쪼개지 말 것"},
        "blocks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["block", "fields"], "properties": {
          "block": {"$ref": "#/definitions/id"}, "fields": {"type": "object"}
        }}}
      }
    },

    "decomposed": {
      "description": "분해기 출력 — PDF 한 면 / 이미지 / 프롬프트 → 원자 목록 + 부품 후보(원자 번호 묶음)",
      "type": "object", "required": ["from", "atoms"],
      "properties": {
        "from": {"type": "string"},
        "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm"},
        "atoms": {"type": "array", "items": {"$ref": "#/definitions/atom"}},
        "tokens": {"type": "object", "description": "잰 값 — 토큰 이름 → 색·서체 (옷 후보)"},
        "parts": {"type": "array", "items": {"type": "object", "required": ["name", "atoms"], "properties": {"name": {"type": "string"}, "atoms": {"type": "array", "items": {"type": "integer"}}, "like": {"$ref": "#/definitions/id", "description": "닮은 기존 부품"}}}}
      }
    }
  },

  "type": "object",
  "properties": {
    "parts": {"type": "array", "items": {"$ref": "#/definitions/part"}},
    "blocks": {"type": "array", "items": {"$ref": "#/definitions/block"}},
    "pages": {"type": "array", "items": {"$ref": "#/definitions/page"}},
    "specs": {"type": "array", "items": {"$ref": "#/definitions/spec"}},
    "plans": {"type": "array", "items": {"$ref": "#/definitions/plan"}},
    "skins": {"type": "array", "items": {"$ref": "#/definitions/skin"}},
    "sets": {"type": "array", "items": {"$ref": "#/definitions/set"}}
  }
}
