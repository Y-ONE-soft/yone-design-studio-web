        "layers": {"type": "array", "items": {"$ref": "#/definitions/layer"}, "description": "레이어 — 뒤에서 앞 순서"},
        "baseline_grid": {"$ref": "#/definitions/baseline_grid"},
        "mirror": {"type": "boolean", "description": "오른쪽 면에서 좌우 반전"},
        "push": {"enum": ["row"], "description": "자라면 아래 것 모두 밀기 — 글상자가 원고만큼 자라면 가로 위치와 상관없이 그 아래 것 전부를 민다(없으면 가로로 겹치는 것만)"},
        "background": {"$ref": "#/definitions/token"},
        "spec": {"$ref": "#/definitions/id", "description": "이 지면을 그린 규격(캔버스용). 틀에 들어가면 틀의 규격을 따른다"},
        "layout": {"enum": ["one", "pair", "two", "none"], "description": "캔버스 레이아웃 — 1단 · 상하 · 2단 · 없음(간지·표지). 칸(zones)은 이것과 여백으로 만든다"},
        "margins": {"type": "object", "description": "여백(mm) — 판면·자석·새 요소 자리의 기준(인디자인 「여백 및 단」). inside/outside 를 적으면 마주보는 책에서 면마다 좌우로 편다(제본쪽이 안쪽)", "properties": {"top": {"$ref": "#/definitions/mm"}, "bottom": {"$ref": "#/definitions/mm"}, "left": {"$ref": "#/definitions/mm"}, "right": {"$ref": "#/definitions/mm"}, "inside": {"$ref": "#/definitions/mm"}, "outside": {"$ref": "#/definitions/mm"}}},
        "columns": {"type": "object", "description": "단(인디자인 「여백 및 단」) — 판면을 n 단으로 나눈 안내선. 원고는 단 순서로 들어간다(왼쪽 단 위→아래, 다음 단). 여러 단에 걸친 상자는 그 높이에서 먼저", "properties": {"n": {"type": "integer", "minimum": 1, "maximum": 6}, "gutter": {"$ref": "#/definitions/mm"}}},
        "items": {"type": "array", "description": "자유 배치 요소(캔버스) — 좌표에 놓은 블록(견본 값으로 그림) 또는 부품. 파워포인트의 개체. 블록이면 옷이 고른 모양으로",
                  "items": {"type": "object", "required": ["x", "y"], "properties": {
                    "block": {"$ref": "#/definitions/id"}, "part": {"$ref": "#/definitions/id"},
                    "atom": {"$ref": "#/definitions/atom", "description": "낱개 원자(글상자·선·면·원·그림). 원점은 0,0 — 자리는 x,y"},
                    "x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "w": {"$ref": "#/definitions/mm", "description": "폭 — 없으면 부품 폭"}, "s": {"type": "number", "exclusiveMinimum": 0, "description": "균일 확대·축소 배율 — 요소·그룹 전체(글자 크기까지)를 모서리 손잡이로 키우고 줄일 때. 없으면 1. 폭(w)에 맞춘 뒤 곱한다"},
                    "fields": {"type": "object", "description": "이 자리의 견본 값(선택)"},
                    "lock": {"type": "boolean", "description": "잠금 — 캔버스에서 못 고른다"}, "hide": {"type": "boolean", "description": "숨김 — 안 그린다"}, "flow": {"type": "boolean", "description": "쌓기 자리 — 책에서 이 자리에 세트를 하나씩 아래로 쌓고, 면이 차면 다음 면에 이어 쌓는다(정답지·어휘 목록). 한 면에 한 세트가 아니다"}, "gap": {"$ref": "#/definitions/mm", "description": "쌓기 간격(flow). 없으면 2"}}}},
        "guides": {"type": "object", "description": "캔버스 안내선(mm)", "properties": {"v": {"type": "array", "items": {"$ref": "#/definitions/mm"}}, "h": {"type": "array", "items": {"$ref": "#/definitions/mm"}}}},
        "blocks": {"type": "array", "description": "캔버스에서 칸에 놓은 블록(견본 배치). 실제 콘텐츠는 세트로 흘러 들어오고, 이건 지면을 설계·미리볼 때 쓴다",
                   "items": {"type": "object", "required": ["zone", "block"], "properties": {"zone": {"$ref": "#/definitions/id"}, "block": {"$ref": "#/definitions/id"}}}}
