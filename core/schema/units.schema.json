      "type": "object", "required": ["id", "name", "source", "fields", "variants"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "name": {"type": "string"},
        "family": {"type": "string", "pattern": "^B(1[01]|[1-9])$", "description": "블록 지도 갈래 B1~B11 (참고용)"},
        "accepts": {"type": "array", "items": {"type": "string", "maxLength": 60},
                    "description": "받는 원고 항목 — contents 의 key(vocab-choice …)나 원고 유형 이름. 이 목록에 있으면 그 원고가 이 블록에 꽂힌다. 블록 목록이 곧 매칭표다"},
        "kind": {"type": "string", "description": "원고 유형 이름 — 원고와 짝짓는 이름. 없으면 블록 이름을 쓴다. 같은 유형이면 블록이 달라도 원고가 꽂힌다"},
        "group": {"$ref": "#/definitions/id", "description": "요소 카테고리 id (요소 패널의 묶음). 없으면 family 로 정해진 기본 자리"},
        "source": {"enum": ["content", "system", "none"], "description": "content = 콘텐츠팀이 채움 · system = 책이 채움(쪽번호·러닝헤드·간지) · none = 장식만"},
        "fields": {"type": "object", "additionalProperties": {"$ref": "#/definitions/field"}},
        "variants": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["id", "part"], "properties": {"id": {"$ref": "#/definitions/id"}, "name": {"type": "string"}, "part": {"$ref": "#/definitions/id", "description": "이 모양으로 그릴 부품. 부품의 bind 이름 = 필드 이름"}}}
        }
      }
