{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "yone/units-v1",
  "title": "디자인 단위 v1 — 원자 → 부품 → 블록 → 지면 → 틀 · 옷 · 세트",
  "description": "치수는 mm(원점 = 부모의 왼쪽 위), 글자 크기·선 굵기는 pt. 색·서체는 값이 아니라 토큰 이름($이름)으로만 적고 값은 옷(skin)이 준다. PDF·이미지·프롬프트 분해기의 출력도 같은 원자(atom) 형식이다. 설명과 보기는 docs/디자인_단위_스키마.md.",
  "definitions": {

    "mm": {"type": "number"},
    "pt": {"type": "number", "minimum": 0},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
    "token": {"type": "string", "pattern": "^\\$[a-z][a-z0-9_]*$", "description": "토큰 참조. 옷의 tokens.color / tokens.font 에서 값을 찾는다"},
    "bind": {"type": "string", "pattern": "^(sys\\.)?[a-z][a-z0-9_]*$", "description": "이 원자에 들어갈 필드 이름. sys.page_no · sys.section · sys.title 은 책이 채운다"},

    "box": {
      "type": "object", "required": ["x", "y", "w", "h"],
      "properties": {"x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm"}}
    },
    "stroke": {
      "type": "object",
      "properties": {"w": {"$ref": "#/definitions/pt"}, "color": {"$ref": "#/definitions/token"}, "dash": {"type": "array", "items": {"$ref": "#/definitions/pt"}},
                     "cap": {"enum": ["butt", "round", "square"], "description": "선 끝 모양(인디자인 Cap). 없으면 butt"}}
    },
    "rotate": {"type": "number", "minimum": -360, "maximum": 360, "description": "회전 각도(°, 시계 방향, 원자의 가운데를 축으로). 없으면 0"},
    "opacity": {"type": "number", "minimum": 0, "maximum": 1, "description": "불투명도 0~1. 없으면 1"},
    "run": {
      "description": "서식 조각 — 글 안에서 굵게·기울임·밑줄·위첨자·다른 색·서체·크기가 섞인 부분(인디자인 문자 스타일). core/render_vivlio/richtext.py 형식 + color·font·size",
      "type": "object", "required": ["t"],
      "properties": {
        "t": {"type": "string"}, "b": {"type": "boolean"}, "i": {"type": "boolean"}, "u": {"type": "boolean"},
        "sup": {"type": "boolean"}, "sub": {"type": "boolean"},
        "color": {"$ref": "#/definitions/token"}, "font": {"$ref": "#/definitions/token"}, "size": {"$ref": "#/definitions/pt"}
      }
    },
    "rich": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"$ref": "#/definitions/run"}]}},

    "atom": {
      "description": "원자 — 인디자인 오브젝트 하나: text(글상자) line(선) rect(면) ellipse(원) image(그림) path(도형). 콘텐츠는 bind 로만 들어온다. 모두 rotate·opacity 를 가질 수 있다",
      "oneOf": [
        {"$ref": "#/definitions/atom_text"}, {"$ref": "#/definitions/atom_line"}, {"$ref": "#/definitions/atom_rect"},
        {"$ref": "#/definitions/atom_ellipse"}, {"$ref": "#/definitions/atom_image"}, {"$ref": "#/definitions/atom_path"}
      ]
    },
    "atom_text": {
      "type": "object", "required": ["t", "x", "y", "w", "h", "font", "size"],
      "properties": {
        "t": {"const": "text"},
        "x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "w": {"$ref": "#/definitions/mm"},
        "h": {"$ref": "#/definitions/mm", "description": "최소 높이. 글이 길면 아래로 늘어난다"},
        "font": {"$ref": "#/definitions/token"}, "size": {"$ref": "#/definitions/pt"},
        "color": {"$ref": "#/definitions/token"}, "leading": {"$ref": "#/definitions/pt"},
        "align": {"enum": ["left", "center", "right", "justify"]},
        "text": {"oneOf": [{"type": "string"}, {"$ref": "#/definitions/rich"}], "description": "고정 글 또는 견본 글(bind 가 있으면 견본). 서식이 섞이면 조각 목록(rich)"},
        "bind": {"$ref": "#/definitions/bind"},
        "rotate": {"$ref": "#/definitions/rotate"}, "opacity": {"$ref": "#/definitions/opacity"}
      }
    },
    "atom_line": {
      "type": "object", "required": ["t", "x1", "y1", "x2", "y2"],
      "properties": {
        "t": {"const": "line"},
        "x1": {"$ref": "#/definitions/mm"}, "y1": {"$ref": "#/definitions/mm"}, "x2": {"$ref": "#/definitions/mm"}, "y2": {"$ref": "#/definitions/mm"},
        "stroke": {"$ref": "#/definitions/stroke"},
        "opacity": {"$ref": "#/definitions/opacity"}
      }
    },
    "atom_rect": {
      "type": "object", "required": ["t", "x", "y", "w", "h"],
      "properties": {
        "t": {"const": "rect"},
        "x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm"},
        "fill": {"$ref": "#/definitions/token"}, "stroke": {"$ref": "#/definitions/stroke"}, "radius": {"$ref": "#/definitions/mm"},
        "rotate": {"$ref": "#/definitions/rotate"}, "opacity": {"$ref": "#/definitions/opacity"}
      }
    },
    "atom_ellipse": {
      "type": "object", "required": ["t", "x", "y", "w", "h"],
      "properties": {
        "t": {"const": "ellipse"},
        "x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm"},
        "fill": {"$ref": "#/definitions/token"}, "stroke": {"$ref": "#/definitions/stroke"},
        "rotate": {"$ref": "#/definitions/rotate"}, "opacity": {"$ref": "#/definitions/opacity"}
      }
    },
    "atom_image": {
      "type": "object", "required": ["t", "x", "y", "w", "h"],
      "properties": {
        "t": {"const": "image"},
        "x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm"},
        "src": {"type": "string", "description": "옷의 images 키. 옷마다 파일을 바꿔 끼운다"},
        "bind": {"$ref": "#/definitions/bind"},
        "fit": {"enum": ["contain", "cover"], "description": "contain = 틀 안에 다 보이게(기본) · cover = 틀을 채우고 넘치는 쪽을 자른다(인디자인 '비율에 맞게 프레임 채우기')"},
        "rotate": {"$ref": "#/definitions/rotate"}, "opacity": {"$ref": "#/definitions/opacity"}
      }
    },
    "atom_path": {
      "description": "도형 — 인디자인 Polygon·펜 패스(화살표·체크·말풍선·삼각형·로고). 좌표는 x y w h 상자 안의 0~1 비율이라 폭·높이를 바꾸면 따라 늘어난다",
      "type": "object", "required": ["t", "x", "y", "w", "h", "d"],
      "properties": {
        "t": {"const": "path"},
        "x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm"},
        "d": {"type": "string", "pattern": "^[MLCQZmlcqz0-9 .,-]+$", "description": "SVG path 문법(M L C Q Z 만), 좌표는 0~1 비율. 예: 삼각형 \"M0 0 L1 0.5 L0 1 Z\""},
        "fill": {"$ref": "#/definitions/token"}, "stroke": {"$ref": "#/definitions/stroke"},
        "evenodd": {"type": "boolean", "description": "구멍 뚫린 도형(짝홀 채움)"},
        "rotate": {"$ref": "#/definitions/rotate"}, "opacity": {"$ref": "#/definitions/opacity"}
      }
    },

    "part": {
      "description": "부품 — 원자 묶음. 콘텐츠 자리는 원자의 bind 로 열린다. 부품 안에 부품 없음",
      "type": "object", "required": ["id", "name", "w", "h", "atoms"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "name": {"type": "string"},
        "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm", "description": "최소 높이"},
        "atoms": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/atom"}},
        "from": {"type": "string", "description": "분해기가 만들었으면 출처 — 'pdf:<파일>#<면>' · 'image:<파일>' · 'prompt'"}
      }
    },

    "field": {
      "type": "object", "required": ["type"],
      "properties": {
        "type": {"enum": ["text", "rich", "number", "choices", "answer", "image", "bool"], "description": "rich = 서식 조각 목록(core/render_vivlio/richtext.py 형식)"},
        "label": {"type": "string"}, "required": {"type": "boolean"}
      }
    },

    "block": {
      "description": "블록 — 유형 1개. 필드 스키마 + 그리는 부품(모양) 1개 이상. 콘텐츠 연동 단위",
      "type": "object", "required": ["id", "name", "source", "fields", "variants"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "name": {"type": "string"},
        "family": {"type": "string", "pattern": "^B(1[01]|[1-9])$", "description": "블록 지도 갈래 B1~B11 (참고용)"},
        "source": {"enum": ["content", "system", "none"], "description": "content = 콘텐츠팀이 채움 · system = 책이 채움(쪽번호·러닝헤드·간지) · none = 장식만"},
        "fields": {"type": "object", "additionalProperties": {"$ref": "#/definitions/field"}},
        "variants": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["id", "part"], "properties": {"id": {"$ref": "#/definitions/id"}, "name": {"type": "string"}, "part": {"$ref": "#/definitions/id", "description": "이 모양으로 그릴 부품. 부품의 bind 이름 = 필드 이름"}}}
        }
      }
    },

    "zone": {
      "description": "칸 — 지면 안 영역. 세트가 흘러 든다",
      "type": "object", "required": ["id", "x", "y", "w", "h", "flow"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm"},
        "flow": {"enum": ["fixed", "continue", "columns"], "description": "fixed = 세트 1개 고정(넘치면 줄임) · continue = 넘치면 다음 면 같은 칸으로 · columns = 단 나눔"},
        "cols": {"type": "integer", "minimum": 2}, "gutter": {"$ref": "#/definitions/mm"},
        "accepts": {"type": "array", "items": {"type": "string"}, "description": "받는 블록 id 또는 세트 kind. 없으면 전부"}
      }
    },

    "page": {
      "description": "지면 — 칸 배치 + 고정 부품(러닝헤드·쪽번호). PDF 한 면 = 지면 하나",
      "type": "object", "required": ["id", "name", "zones"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "name": {"type": "string"},
        "zones": {"type": "array", "items": {"$ref": "#/definitions/zone"}},
        "chrome": {"type": "array", "items": {"type": "object", "required": ["part", "x", "y"], "properties": {"part": {"$ref": "#/definitions/id"}, "x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}}}},
        "mirror": {"type": "boolean", "description": "오른쪽 면에서 좌우 반전"},
        "background": {"$ref": "#/definitions/token"},
        "spec": {"$ref": "#/definitions/id", "description": "이 지면을 그린 규격(캔버스용). 틀에 들어가면 틀의 규격을 따른다"},
        "layout": {"enum": ["one", "pair", "two", "none"], "description": "캔버스 레이아웃 — 1단 · 상하 · 2단 · 없음(간지·표지). 칸(zones)은 이것과 여백으로 만든다"},
        "margins": {"type": "object", "description": "캔버스 여백(mm) — 칸을 만드는 기준", "properties": {"top": {"$ref": "#/definitions/mm"}, "bottom": {"$ref": "#/definitions/mm"}, "left": {"$ref": "#/definitions/mm"}, "right": {"$ref": "#/definitions/mm"}}},
        "items": {"type": "array", "description": "자유 배치 요소(캔버스) — 좌표에 놓은 블록(견본 값으로 그림) 또는 부품. 파워포인트의 개체. 블록이면 옷이 고른 모양으로",
                  "items": {"type": "object", "required": ["x", "y"], "properties": {
                    "block": {"$ref": "#/definitions/id"}, "part": {"$ref": "#/definitions/id"},
                    "atom": {"$ref": "#/definitions/atom", "description": "낱개 원자(글상자·선·면·원·그림). 원점은 0,0 — 자리는 x,y"},
                    "x": {"$ref": "#/definitions/mm"}, "y": {"$ref": "#/definitions/mm"}, "w": {"$ref": "#/definitions/mm", "description": "폭 — 없으면 부품 폭"},
                    "fields": {"type": "object", "description": "이 자리의 견본 값(선택)"}}}},
        "blocks": {"type": "array", "description": "캔버스에서 칸에 놓은 블록(견본 배치). 실제 콘텐츠는 세트로 흘러 들어오고, 이건 지면을 설계·미리볼 때 쓴다",
                   "items": {"type": "object", "required": ["zone", "block"], "properties": {"zone": {"$ref": "#/definitions/id"}, "block": {"$ref": "#/definitions/id"}}}}
      }
    },

    "section": {
      "description": "구간 — 지면 반복 규칙 + 앞 간지. STEP·PART·DAY·회차",
      "type": "object", "required": ["id", "name", "pages"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "name": {"type": "string"},
        "divider": {"$ref": "#/definitions/id", "description": "앞에 오는 간지 지면"},
        "pages": {"type": "array", "description": "비어 있을 수 있다 — 캔버스에서 막 만든 틀", "items": {"type": "object", "required": ["page", "repeat"], "properties": {
          "page": {"$ref": "#/definitions/id"},
          "repeat": {"enum": ["once", "each_set"], "description": "each_set = 세트마다 이 지면"},
          "sets": {"type": "array", "items": {"type": "string"}, "description": "받는 세트 kind"}
        }}}
      }
    },

    "spec": {
      "description": "규격 — 판형·도련·제본·도수",
      "type": "object", "required": ["id", "w", "h"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm"}, "bleed": {"$ref": "#/definitions/mm"},
        "binding": {"enum": ["perfect", "saddle", "spiral", "loose"]}, "colors": {"enum": [1, 4]},
        "page_multiple": {"type": "integer", "description": "면수 배수 규칙(중철 4)"}
      }
    },

    "plan": {
      "description": "틀 — 구간 순서 + 앞뒤 면. 라인업 이름이 붙는 곳",
      "type": "object", "required": ["id", "name", "spec", "sections"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "name": {"type": "string"}, "spec": {"$ref": "#/definitions/id"},
        "front": {"type": "array", "items": {"$ref": "#/definitions/id"}},
        "sections": {"type": "array", "items": {"$ref": "#/definitions/section"}},
        "back": {"type": "array", "items": {"$ref": "#/definitions/id"}}
      }
    },

    "skin": {
      "description": "옷 — 토큰 값 + 블록별 모양 선택 + 이미지 교체. 브랜드·학교·강사",
      "type": "object", "required": ["id", "name", "tokens"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "name": {"type": "string"},
        "tokens": {"type": "object", "properties": {
          "color": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}},
          "font": {"type": "object", "additionalProperties": {"type": "string", "description": "서체 family 이름"}}
        }},
        "variants": {"type": "object", "additionalProperties": {"$ref": "#/definitions/id"}, "description": "블록 id → 모양 id. 없으면 첫 모양"},
        "images": {"type": "object", "additionalProperties": {"type": "string"}, "description": "image 원자의 src → 파일 경로"}
      }
    },

    "set": {
      "description": "세트 — 콘텐츠가 오는 단위. 함께 오고 함께 놓인다. contents 는 이것만 보낸다",
      "type": "object", "required": ["kind", "id", "blocks"],
      "properties": {
        "kind": {"type": "string", "description": "passage · exam · day …"}, "id": {"type": "string", "description": "지문 번호·회차"},
        "keep": {"type": "boolean", "description": "면 넘어가며 쪼개지 말 것"},
        "blocks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["block", "fields"], "properties": {
          "block": {"$ref": "#/definitions/id"}, "fields": {"type": "object"}
        }}}
      }
    },

    "decomposed": {
      "description": "분해기 출력 — PDF 한 면 / 이미지 / 프롬프트 → 원자 목록 + 부품 후보(원자 번호 묶음)",
      "type": "object", "required": ["from", "atoms"],
      "properties": {
        "from": {"type": "string"},
        "w": {"$ref": "#/definitions/mm"}, "h": {"$ref": "#/definitions/mm"},
        "atoms": {"type": "array", "items": {"$ref": "#/definitions/atom"}},
        "tokens": {"type": "object", "description": "잰 값 — 토큰 이름 → 색·서체 (옷 후보)"},
        "parts": {"type": "array", "items": {"type": "object", "required": ["name", "atoms"], "properties": {"name": {"type": "string"}, "atoms": {"type": "array", "items": {"type": "integer"}}, "like": {"$ref": "#/definitions/id", "description": "닮은 기존 부품"}}}}
      }
    }
  },

  "type": "object",
  "properties": {
    "parts": {"type": "array", "items": {"$ref": "#/definitions/part"}},
    "blocks": {"type": "array", "items": {"$ref": "#/definitions/block"}},
    "pages": {"type": "array", "items": {"$ref": "#/definitions/page"}},
    "specs": {"type": "array", "items": {"$ref": "#/definitions/spec"}},
    "plans": {"type": "array", "items": {"$ref": "#/definitions/plan"}},
    "skins": {"type": "array", "items": {"$ref": "#/definitions/skin"}},
    "sets": {"type": "array", "items": {"$ref": "#/definitions/set"}}
  }
}
