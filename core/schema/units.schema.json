      "type": "object", "required": ["id", "name"],
      "properties": {"id": {"$ref": "#/definitions/id"}, "name": {"type": "string"},
                     "hide": {"type": "boolean"}, "lock": {"type": "boolean"}, "nonprint": {"type": "boolean"}}
