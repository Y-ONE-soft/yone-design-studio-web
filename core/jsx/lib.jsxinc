// core/jsx/lib.jsxinc — 공용 JSX 코어 (Phase 3)
//
// 신규 엔진(동형 등)과 core 도구(dump/template_spec)가 공유하는 유틸.
// 기존 엔진 14개의 run.jsx는 이번 여름 동결 — 이 파일을 include하지 않는다.
// 사용: core.indesign.jsxbuild.build_jsx()가 빌드 시점에 본문 앞에 concat.
//
// ExtendScript ES3 제약: let/const/화살표/템플릿 리터럴/JSON 내장 객체 금지.
// 전역 __LIB_LOG_PATH__ 를 본문(또는 빌더 치환)에서 정의하면 wlog가 사용.

// ── 로그 ─────────────────────────────────────────────────────────────────────
function wlog(msg) {
    try {
        var f = new File(typeof __LIB_LOG_PATH__ != "undefined" ? __LIB_LOG_PATH__ : "/tmp/yone_jsx.log");
        f.encoding = "UTF-8";
        f.open("a");
        f.writeln(msg);
        f.close();
    } catch (e) {}
}

// ── JSON 직렬화 (ES3 — JSON 내장 없음) ──────────────────────────────────────
function jsonEscape(s) {
    if (s === null || s === undefined) { return "null"; }
    s = String(s);
    var out = '"';
    for (var i = 0; i < s.length; i++) {
        var c = s.charCodeAt(i);
        if (c === 0x22) { out += '\\"'; }
        else if (c === 0x5C) { out += '\\\\'; }
        else if (c === 0x0A) { out += '\\n'; }
        else if (c === 0x0D) { out += '\\r'; }
        else if (c === 0x09) { out += '\\t'; }
        else if (c < 0x20 || c >= 0x7F) {
            // 비ASCII 전부 \uXXXX — ExtendScript File.write가 특정 문자
            // (외자 서러게이트 등)에서 0바이트로 조용히 실패하는 문제 회피
            var hex = c.toString(16);
            while (hex.length < 4) { hex = "0" + hex; }
            out += '\\u' + hex;
        } else {
            out += s.charAt(i);
        }
    }
    return out + '"';
}

function jsonStringify(obj) {
    if (obj === null || obj === undefined) { return "null"; }
    var t = typeof obj;
    if (t === "string") { return jsonEscape(obj); }
    if (t === "number" || t === "boolean") { return String(obj); }
    if (obj instanceof Array) {
        var arr = [];
        for (var i = 0; i < obj.length; i++) { arr.push(jsonStringify(obj[i])); }
        return "[" + arr.join(",") + "]";
    }
    var props = [];
    for (var k in obj) {
        if (obj.hasOwnProperty(k)) {
            props.push(jsonEscape(k) + ":" + jsonStringify(obj[k]));
        }
    }
    return "{" + props.join(",") + "}";
}

function writeJSON(path, obj) {
    var f = new File(path);
    f.encoding = "UTF-8";
    if (!f.open("w")) { throw "writeJSON open 실패: " + path; }
    var payload = jsonStringify(obj);
    var ok = f.write(payload);
    f.close();
    var written = new File(path).length;
    if (!ok || written <= 0) { throw "writeJSON write 실패 (bytes=" + written + "): " + path; }
}

// ── 스타일 ───────────────────────────────────────────────────────────────────
// 전체 그룹 경로 ("그룹 > 하위그룹 > 스타일") — 중첩 그룹 재귀 지원
function styleFullPath(st) {
    try {
        var parts = [st.name];
        var par = st.parent;
        while (par && par.constructor && par.constructor.name.indexOf("StyleGroup") !== -1) {
            parts.unshift(par.name);
            par = par.parent;
        }
        return parts.join(" > ");
    } catch (e) { return ""; }
}

// "그룹 > 이름" 전체 경로로 단락스타일 찾기 (그룹 없으면 루트에서)
function findParagraphStyleByPath(doc, fullPath) {
    var parts = fullPath.split(">");
    for (var i = 0; i < parts.length; i++) {
        parts[i] = parts[i].replace(/^\s+|\s+$/g, "");
    }
    var container = doc;
    for (var gi = 0; gi < parts.length - 1; gi++) {
        var grp = container.paragraphStyleGroups.itemByName(parts[gi]);
        if (!grp.isValid) { return null; }
        container = grp;
    }
    var st = container.paragraphStyles.itemByName(parts[parts.length - 1]);
    return st.isValid ? st : null;
}

// "그룹 > 이름" 전체 경로로 문자스타일 찾기 (그룹 없으면 루트에서)
function findCharacterStyleByPath(doc, fullPath) {
    var parts = fullPath.split(">");
    for (var i = 0; i < parts.length; i++) {
        parts[i] = parts[i].replace(/^\s+|\s+$/g, "");
    }
    var container = doc;
    for (var gi = 0; gi < parts.length - 1; gi++) {
        var grp = container.characterStyleGroups.itemByName(parts[gi]);
        if (!grp.isValid) { return null; }
        container = grp;
    }
    var st = container.characterStyles.itemByName(parts[parts.length - 1]);
    return st.isValid ? st : null;
}

// ── 페이지/스토리 탐색 ───────────────────────────────────────────────────────
// 마커 텍스트를 포함한 텍스트프레임이 있는 첫 페이지 (내지 개편에도 강건)
function findPageByMarker(doc, marker) {
    var pages = doc.pages.everyItem().getElements();
    for (var pi = 0; pi < pages.length; pi++) {
        var tfs = pages[pi].textFrames.everyItem ? pages[pi].textFrames : null;
        var frames = pages[pi].textFrames;
        for (var fi = 0; fi < frames.length; fi++) {
            try {
                if (String(frames[fi].contents).indexOf(marker) !== -1) {
                    return pages[pi];
                }
            } catch (e) {}
        }
    }
    return null;
}

// 페이지에서 가장 많은 프레임을 가진 스토리 = 메인 콘텐츠 스토리
function mainStoryOnPage(page) {
    var best = null;
    var bestCount = -1;
    var frames = page.textFrames;
    for (var fi = 0; fi < frames.length; fi++) {
        try {
            var st = frames[fi].parentStory;
            var cnt = st.textContainers.length;
            if (cnt > bestCount) { bestCount = cnt; best = st; }
        } catch (e) {}
    }
    return best;
}

// ── 라벨 탐색 (인라인 아이콘 등) ─────────────────────────────────────────────
function findLabeledItem(doc, label) {
    var items = doc.allPageItems;
    for (var i = 0; i < items.length; i++) {
        try { if (items[i].label === label) { return items[i]; } } catch (e) {}
    }
    return null;
}
