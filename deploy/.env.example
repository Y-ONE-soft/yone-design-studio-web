# ── Fly.io 비밀값 목록 (fly secrets set …) — 값은 절대 리포에 적지 않는다. 자세한 뜻은 deploy/README.md 2절 ──
# 로컬에서 인증까지 시험할 때만 이 파일을 .env 로 복사해 채우고 `set -a; . ./.env; set +a; bin/studio`

YOS_LINK_SECRET=            # Y.OS 쪽 STUDIO_LINK_SECRET 과 같은 값 (있으면 인증 켜짐). openssl rand -base64 24
SERVICE_TOKEN=              # Y.OS 쪽 STUDIO_SERVICE_TOKEN 과 같은 값 (콤마로 여러 개 가능)
YONE_SECRET_KEY=            # 세션 쿠키·임베드 토큰 서명. openssl rand -hex 32
YOS_LOGIN_URL=https://yos-design-web.vercel.app/studio
YOS_ORIGINS=https://yos-contents-web.vercel.app,https://yos-design-web.vercel.app,https://yos-core-web.vercel.app

BLOB_READ_WRITE_TOKEN=      # contents 와 같은 Vercel Blob 스토어 토큰 (없으면 Blob 안 씀)
#YOS_BLOB_PDF_ACCESS=private
YOS_WEBHOOK_URL=            # 예: https://yos-contents-web.vercel.app/api/hooks/studio (없으면 안 보냄)
YOS_CONTENTS_API=           # 예: https://yos-contents-web.vercel.app ("contents 에서 가져오기")
YOS_CONTENTS_TOKEN=

ANTHROPIC_API_KEY=
YONE_ASSIST_MODEL=claude-opus-5
#YONE_ALLOWED_ROLES=admin,designer,staff
